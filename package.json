{
  "name": "ioc-sentinel",
  "version": "1.1.0",
  "description": "IOC extractor for threat intel and incident response: pulls URLs, domains, IPv4/IPv6, emails, MD5/SHA1/SHA256/SHA512, CVEs, ATT&CK IDs, crypto wallets and registry keys from text, logs and reports, refangs defanged IOCs, filters noise and exports JSON, CSV, STIX 2.1 and SARIF. Zero deps.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ioc-sentinel": "bin/ioc-sentinel.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ioc",
    "indicators-of-compromise",
    "threat-intelligence",
    "cti",
    "incident-response",
    "dfir",
    "stix",
    "refang",
    "defang",
    "malware-analysis",
    "security",
    "sarif",
    "cli",
    "github-action"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/ioc-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/ioc-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/ioc-sentinel/",
  "dependencies": {
    "defang-sentinel": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
